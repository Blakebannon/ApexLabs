{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-labs.local/contracts/v1/inferential-analysis-definition.schema.json",
  "title": "Apex Labs inferential analysis definition v1",
  "description": "A preregistered inferential analysis over one comparable evidence set. This contract is deliberately separate from apex-labs.analysis-definition/v1, which remains descriptive-observational only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_id", "version", "title", "scientific_question", "hypothesis", "null_hypothesis", "classification", "synthetic", "protocol", "evidence_set", "evidence_scope", "primary_metric", "secondary_metrics", "experimental_unit", "resampling_unit", "grouping", "comparisons", "family", "uncertainty", "missing_data_policy", "outlier_policy", "sufficiency_rule", "replication_policy", "interpretation_ceiling", "falsification_tests", "limitations"],
  "properties": {
    "schema_version": {"const": "apex-labs.inferential-analysis-definition/v1"},
    "analysis_id": {"$ref": "#/$defs/id"},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "scientific_question": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "null_hypothesis": {"type": "string", "minLength": 1},
    "classification": {"enum": ["confirmatory", "exploratory"]},
    "synthetic": {"type": "boolean"},
    "protocol": {
      "type": "object", "additionalProperties": false,
      "required": ["freeze_id", "freeze_sha256", "experiment_id", "experiment_version"],
      "properties": {
        "freeze_id": {"$ref": "#/$defs/id"}, "freeze_sha256": {"$ref": "#/$defs/sha256"},
        "experiment_id": {"$ref": "#/$defs/id"}, "experiment_version": {"type": "string", "minLength": 1}
      }
    },
    "evidence_set": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_set_id", "version", "definition_sha256"],
      "properties": {"evidence_set_id": {"$ref": "#/$defs/id"}, "version": {"type": "string", "minLength": 1}, "definition_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "evidence_scope": {"enum": ["primary", "holdout"]},
    "primary_metric": {"$ref": "#/$defs/metric_binding"},
    "secondary_metrics": {"type": "array", "items": {"$ref": "#/$defs/metric_binding"}},
    "experimental_unit": {"$ref": "#/$defs/unit_level"},
    "resampling_unit": {"$ref": "#/$defs/unit_level"},
    "grouping": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "unpaired_justification"],
      "properties": {
        "kind": {"enum": ["paired", "unpaired"]},
        "unpaired_justification": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "comparisons": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["comparison_id", "role", "method", "metric_id", "directionality", "effect_size", "practical_threshold", "subset"],
        "properties": {
          "comparison_id": {"$ref": "#/$defs/id"},
          "subset": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object", "additionalProperties": false,
                "required": ["field", "value"],
                "properties": {"field": {"enum": ["pair_key", "block_id", "session_id", "condition_id"]}, "value": {"type": "string", "minLength": 1}}
              }
            ]
          },
          "role": {"enum": ["primary", "secondary", "exploratory"]},
          "method": {"enum": ["paired_difference", "unpaired_difference", "trend", "consistency"]},
          "metric_id": {"$ref": "#/$defs/id"},
          "directionality": {"enum": ["decrease_is_improvement", "increase_is_improvement", "two_sided_no_preferred_direction"]},
          "effect_size": {"enum": ["median_paired_difference", "mean_paired_difference", "median_difference", "mean_difference", "theil_sen_slope", "dispersion_ratio"]},
          "practical_threshold": {
            "type": "object", "additionalProperties": false,
            "required": ["magnitude", "unit", "source", "rationale"],
            "properties": {
              "magnitude": {"type": "number", "minimum": 0},
              "unit": {"type": "string", "minLength": 1},
              "source": {"enum": ["frozen_protocol", "documented_pilot", "not_declared"]},
              "rationale": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "family": {
      "type": "object", "additionalProperties": false,
      "required": ["family_id", "role", "correction", "alpha", "members"],
      "properties": {
        "family_id": {"$ref": "#/$defs/id"},
        "role": {"enum": ["confirmatory_primary", "confirmatory_secondary", "exploratory"]},
        "correction": {"enum": ["holm_bonferroni", "benjamini_hochberg", "none"]},
        "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "members": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}
      }
    },
    "uncertainty": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "coverage_level", "bootstrap_draws", "random_seed", "resampling_unit", "interval_semantics", "minimum_resampling_clusters"],
      "properties": {
        "method": {"enum": ["deterministic_cluster_percentile_bootstrap", "none"]},
        "coverage_level": {"type": ["number", "null"], "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "bootstrap_draws": {"type": ["integer", "null"], "minimum": 200, "maximum": 100000},
        "random_seed": {"type": ["integer", "null"], "minimum": 0},
        "resampling_unit": {"$ref": "#/$defs/unit_level"},
        "interval_semantics": {"type": "string", "minLength": 1},
        "minimum_resampling_clusters": {"type": "integer", "minimum": 2}
      }
    },
    "missing_data_policy": {"enum": ["exclude_unit_and_report", "refuse_analysis"]},
    "outlier_policy": {"enum": ["retain_all_and_report_sensitivity", "preregistered_rule_only"]},
    "sufficiency_rule": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "minimum_experimental_units", "minimum_pairs", "minimum_resampling_clusters", "minimum_participants", "stopping_rule", "source_declarations", "pilot_reference"],
      "properties": {
        "source": {"enum": ["frozen_protocol", "documented_pilot", "not_declared"]},
        "minimum_experimental_units": {"type": ["integer", "null"], "minimum": 1},
        "minimum_pairs": {"type": ["integer", "null"], "minimum": 1},
        "minimum_resampling_clusters": {"type": ["integer", "null"], "minimum": 2},
        "minimum_participants": {"type": ["integer", "null"], "minimum": 1},
        "stopping_rule": {"type": "string", "minLength": 1},
        "source_declarations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "pilot_reference": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["document_id", "sha256", "completed_at"],
              "properties": {"document_id": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/sha256"}, "completed_at": {"type": "string", "format": "date-time"}}
            }
          ]
        }
      }
    },
    "replication_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "required_scope", "holdout_inspected"],
      "properties": {
        "state": {"enum": ["not_required", "required_before_validation", "this_run_is_the_replication"]},
        "required_scope": {"enum": ["not_applicable", "same_block", "same_session", "different_session", "same_car_track", "different_track", "different_car", "different_participant"]},
        "holdout_inspected": {"const": false}
      }
    },
    "interpretation_ceiling": {"enum": ["descriptive", "associational", "intervention_associated", "causal_candidate"]},
    "falsification_tests": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["test_id", "kind", "description"],
        "properties": {
          "test_id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["leave_one_unit_out", "leave_one_cluster_out", "outlier_dependence", "order_effect_early_versus_late", "isolation_by_cluster", "direction_sign_stability"]},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {"if": {"properties": {"grouping": {"properties": {"kind": {"const": "unpaired"}}}}}, "then": {"properties": {"grouping": {"properties": {"unpaired_justification": {"type": "string"}}}}}},
    {"if": {"properties": {"grouping": {"properties": {"kind": {"const": "paired"}}}}}, "then": {"properties": {"grouping": {"properties": {"unpaired_justification": {"type": "null"}}}}}},
    {"if": {"properties": {"uncertainty": {"properties": {"method": {"const": "deterministic_cluster_percentile_bootstrap"}}}}}, "then": {"properties": {"uncertainty": {"properties": {"coverage_level": {"type": "number"}, "bootstrap_draws": {"type": "integer"}, "random_seed": {"type": "integer"}}}}}},
    {"if": {"properties": {"classification": {"const": "confirmatory"}}}, "then": {"properties": {"family": {"properties": {"role": {"enum": ["confirmatory_primary", "confirmatory_secondary"]}}}}}},
    {"if": {"properties": {"classification": {"const": "exploratory"}}}, "then": {"properties": {"family": {"properties": {"role": {"const": "exploratory"}}}}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unit_level": {"enum": ["telemetry_frame", "event", "segment_opportunity", "lap", "stint", "block", "session", "participant"]},
    "metric_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["metric_id", "version", "sha256"],
      "properties": {"metric_id": {"$ref": "#/$defs/id"}, "version": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
