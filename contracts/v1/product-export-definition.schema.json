{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-labs.local/contracts/v1/product-export-definition.schema.json",
  "title": "Apex Labs product export definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "export_id", "created_at", "apex_labs_version", "apex_labs_source_commit", "summary", "finding_paths", "validation_paths", "metric_paths", "algorithm_paths"],
  "properties": {
    "schema_version": {"const": "apex-labs.product-export-definition/v1"},
    "export_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"},
    "apex_labs_version": {"type": "string", "minLength": 1},
    "apex_labs_source_commit": {"$ref": "#/$defs/commit"},
    "summary": {"type": "string", "minLength": 1},
    "finding_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "validation_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "metric_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "algorithm_paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "commit": {"type": "string", "pattern": "^([0-9a-f]{7,40}|UNCOMMITTED)$"}
  }
}
