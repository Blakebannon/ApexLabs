{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-labs.local/contracts/v1/normalized-manifest.schema.json",
  "title": "Apex Labs normalized dataset manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "dataset_fingerprint", "synthetic", "created_at", "source_manifest_sha256", "canonical_source_manifest_sha256", "source_fingerprint", "normalization_version", "adapter", "code_identity", "preprocessing", "collection_context", "temporal_policy", "conventions", "integrity_summary", "records_file", "records_sha256", "record_counts", "source_files", "capabilities", "unknown_source_channels"],
  "properties": {
    "schema_version": {"const": "apex-labs.normalized-manifest/v1"},
    "dataset_id": {"$ref": "#/$defs/id"},
    "dataset_fingerprint": {"$ref": "#/$defs/sha256"},
    "synthetic": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_fingerprint": {"$ref": "#/$defs/sha256"},
    "normalization_version": {"type": "string", "minLength": 1},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "configuration"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"type": "string", "minLength": 1}, "configuration": {"type": "object"}}
    },
    "code_identity": {"$ref": "#/$defs/code_identity"},
    "preprocessing": {
      "type": "object", "additionalProperties": false,
      "required": ["pipeline_id", "pipeline_version", "configuration", "configuration_sha256"],
      "properties": {"pipeline_id": {"$ref": "#/$defs/id"}, "pipeline_version": {"type": "string", "minLength": 1}, "configuration": {"type": "object"}, "configuration_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "collection_context": {"$ref": "dataset-manifest.schema.json#/properties/collection_context"},
    "temporal_policy": {"$ref": "#/$defs/temporal_policy"},
    "conventions": {
      "type": "object", "additionalProperties": false,
      "required": ["vehicle_frame", "steering_sign", "yaw_rate_sign", "lateral_acceleration_sign", "longitudinal_acceleration_sign", "track_position_frame"],
      "properties": {
        "vehicle_frame": {"const": "right_handed_x_forward_y_left_z_up"},
        "steering_sign": {"const": "positive_left"},
        "yaw_rate_sign": {"const": "positive_counterclockwise_viewed_from_above"},
        "lateral_acceleration_sign": {"const": "positive_left"},
        "longitudinal_acceleration_sign": {"const": "positive_forward"},
        "track_position_frame": {"const": "right_handed_adapter_normalized"}
      }
    },
    "integrity_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["record_order", "unique_record_ids", "parent_references", "quality_flag_counts", "interpolation", "gap_detection"],
      "properties": {
        "record_order": {"const": "sequence_index_contiguous_parent_before_child"},
        "unique_record_ids": {"const": true},
        "parent_references": {"const": "verified"},
        "quality_flag_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "interpolation": {"$ref": "#/$defs/interpolation"},
        "gap_detection": {"enum": ["evaluated", "distance_coverage_evaluated", "not_evaluated_no_declared_cadence"]}
      }
    },
    "records_file": {"type": "string", "minLength": 1},
    "records_sha256": {"$ref": "#/$defs/sha256"},
    "record_counts": {
      "type": "object",
      "propertyNames": {"enum": ["session", "lap", "segment", "telemetry_sample", "distance_bin", "driver_input_event"]},
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "source_bundle": {"$ref": "#/$defs/source_bundle"},
    "source_semantics": {"$ref": "#/$defs/source_semantics"},
    "research_eligibility": {"$ref": "#/$defs/research_eligibility"},
    "collection_record": {"$ref": "#/$defs/integrity_bound_file"},
    "product_annotations": {"$ref": "#/$defs/integrity_bound_file"},
    "adapter_conformance": {"$ref": "#/$defs/integrity_bound_file"},
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "role", "media_type"],
        "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "role": {"type": "string", "minLength": 1}, "media_type": {"type": "string", "minLength": 1}}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provenance"],
        "properties": {
          "provenance": {"enum": ["measured", "derived", "estimated", "unavailable"]},
          "unit": {"type": ["string", "null"]},
          "source_channel": {"type": "string", "minLength": 1},
          "derivation": {"type": "string", "minLength": 1}
        }
      }
    },
    "unknown_source_channels": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"required": ["source_bundle"]},
      "then": {
        "required": ["source_semantics", "research_eligibility", "collection_record", "product_annotations", "adapter_conformance"],
        "properties": {
          "adapter": {"properties": {"id": {"const": "apex-session-export"}, "version": {"const": "1.0.0"}}},
          "record_counts": {"required": ["distance_bin"]}
        }
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^(?:[0-9a-f]{7,40}|UNCOMMITTED)$"},
    "code_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["package_version", "git_commit", "git_state", "code_and_schema_sha256", "schema_sha256"],
      "properties": {
        "package_version": {"type": "string", "minLength": 1},
        "git_commit": {"$ref": "#/$defs/commit"},
        "git_state": {"enum": ["clean", "dirty", "uncommitted"]},
        "code_and_schema_sha256": {"$ref": "#/$defs/sha256"},
        "schema_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}}
      }
    },
    "source_bundle": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "sha256", "manifest_sha256", "privacy_mode"],
      "properties": {
        "schema_version": {"const": "apex-session-export/1.0.0"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "privacy_mode": {"type": "string", "minLength": 1}
      }
    },
    "source_semantics": {
      "type": "object", "additionalProperties": false,
      "required": ["record_semantics", "distance_bin_width_m", "interpolation_performed", "time_domain_available"],
      "properties": {
        "record_semantics": {"const": "distance_binned_aggregate_not_raw_frames"},
        "distance_bin_width_m": {"type": "number", "exclusiveMinimum": 0},
        "interpolation_performed": {"const": false},
        "time_domain_available": {"const": false}
      }
    },
    "research_eligibility": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "scientific_promotion_eligible", "reason"],
      "properties": {
        "classification": {"enum": ["observational", "experimental", "integration_validation_only", "synthetic_demo"]},
        "scientific_promotion_eligible": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "integrity_bound_file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[^/\\\\]+(?:/[^/\\\\]+)*$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "interpolation": {
      "type": "object", "additionalProperties": false,
      "required": ["performed", "method", "affected_concepts"],
      "properties": {
        "performed": {"type": "boolean"}, "method": {"type": ["string", "null"]},
        "affected_concepts": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "temporal_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["source_clock", "normalized_clock_origin", "clock_resolution_seconds", "duplicate_timestamp_policy", "clock_reset_policy", "expected_sample_period_seconds", "gap_tolerance_seconds", "lap_distance_regression_policy", "interpolation"],
      "properties": {
        "source_clock": {"type": "string", "minLength": 1},
        "normalized_clock_origin": {"enum": ["session_start", "unix_epoch", "declared_source_epoch"]},
        "clock_resolution_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "duplicate_timestamp_policy": {"enum": ["reject", "allow_with_quality_flag"]},
        "clock_reset_policy": {"enum": ["reject", "allow_with_quality_flag"]},
        "expected_sample_period_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "gap_tolerance_seconds": {"type": ["number", "null"], "minimum": 0},
        "lap_distance_regression_policy": {"enum": ["reject", "allow_with_quality_flag"]},
        "interpolation": {"$ref": "#/$defs/interpolation"}
      }
    }
  }
}
