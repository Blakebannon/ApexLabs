{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-labs.local/contracts/v1/metric-definition.schema.json",
  "title": "Apex Labs metric definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metric_id", "version", "name", "definition", "unit", "directionality", "required_inputs", "computation", "output_provenance", "limitations"],
  "properties": {
    "schema_version": {"const": "apex-labs.metric-definition/v1"},
    "metric_id": {"$ref": "#/$defs/id"},
    "version": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "definition": {"type": "string", "minLength": 1},
    "unit": {"type": "string"},
    "directionality": {"enum": ["higher_is_better", "lower_is_better", "target_range", "descriptive_only"]},
    "required_inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "computation": {"type": "string", "minLength": 1},
    "output_provenance": {"enum": ["derived", "estimated"]},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"}}
}
