    "simulator": {"id": "synthetic-simulator", "version": "synthetic"},
    "car": {"id": "synthetic-car"},
    "track": {"id": "synthetic-track", "layout": "synthetic-layout"},
    "start_utc": "2000-01-01T00:00:00Z",
