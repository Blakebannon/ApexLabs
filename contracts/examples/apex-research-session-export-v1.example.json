    "lap_elapsed_time": true,
    "lap_distance": true,
    "gaps_dropped_frames_and_backpressure_recorded": true
  },
  "channels": [
    {"name": "timestamp", "availability": "available", "provenance": "measured", "unit": "s", "axis_and_sign": "monotonic source clock", "missing_value": "null plus quality event"},
    {"name": "brake", "availability": "available", "provenance": "measured", "unit": "ratio", "axis_and_sign": "0 released; 1 fully applied", "missing_value": "null"},
