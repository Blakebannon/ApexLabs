    {"name": "gear", "availability": "available", "provenance": "measured", "unit": "integer", "axis_and_sign": "simulator-declared gear encoding", "missing_value": "null"},
    {"name": "rpm", "availability": "available", "provenance": "measured", "unit": "rpm", "axis_and_sign": "non-negative", "missing_value": "null"},
    {"name": "longitudinal_acceleration", "availability": "unavailable", "provenance": "unavailable", "unit": null, "axis_and_sign": null, "missing_value": "explicitly unavailable"},
    {"name": "lateral_acceleration", "availability": "unavailable", "provenance": "unavailable", "unit": null, "axis_and_sign": null, "missing_value": "explicitly unavailable"},
